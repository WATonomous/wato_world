#!/usr/bin/env bash
# watod — entrypoint for the wato_world auto-labeling pipeline.
#
# Mirrors wato_monorepo/watod: source watod-config.sh, parse ACTIVE_MODULES
# (with :dev suffix), generate modules/.env, stack compose files, delegate to
# docker compose.  ACTIVE_MODULES is the single source of truth — there's no
# CLI override flag like the monorepo's -m, but you can edit
# watod-config.local.sh per-host.

set -euo pipefail

# ---------------------------------------------------------------------------
# Locate repo root by searching upward for watod-config.sh.
# ---------------------------------------------------------------------------
find_repo_root() {
    local d="${PWD}"
    while [[ "${d}" != "/" ]]; do
        if [[ -f "${d}/watod-config.sh" ]]; then
            echo "${d}"
            return 0
        fi
        d="$(dirname "${d}")"
    done
    cd "$(dirname "${BASH_SOURCE[0]}")" && pwd
}

WATO_WORLD_DIR="$(find_repo_root)"
export WATO_WORLD_DIR

SCRIPTS_DIR="${WATO_WORLD_DIR}/watod_scripts"
MODULES_DIR="${WATO_WORLD_DIR}/modules"

# ---------------------------------------------------------------------------
# Module registry.  Each module declares which base flavor it FROM's so we
# only build the bases that are actually needed.
# ---------------------------------------------------------------------------
ALL_MODULES=(ingest perception_2d lidar_preprocessing proposal_generation tracking label_refinement open_vocab_discovery student_training)

base_flavor_for() {
    case "$1" in
        ingest|lidar_preprocessing) echo "cpu" ;;
        perception_2d|proposal_generation|tracking|label_refinement|open_vocab_discovery|student_training) echo "cuda" ;;
        *) echo "" ;;
    esac
}

# ---------------------------------------------------------------------------
# Source user config (+ optional local override).
# ---------------------------------------------------------------------------
# shellcheck source=/dev/null
source "${WATO_WORLD_DIR}/watod-config.sh"
if [[ -f "${WATO_WORLD_DIR}/watod-config.local.sh" ]]; then
    # shellcheck source=/dev/null
    source "${WATO_WORLD_DIR}/watod-config.local.sh"
fi

VERBOSE=0
TERMINAL=""

# ---------------------------------------------------------------------------
# Help.
# ---------------------------------------------------------------------------
usage() {
    cat <<EOF
watod — wato_world auto-labeling pipeline orchestrator.

Usage:
  watod [OPTIONS] [COMMAND] [ARGS...]

Active modules are read from ACTIVE_MODULES in watod-config.sh.  Append :dev
to a module name to use the develop target with source bind-mounts.  Use
"all" or "all:dev" to expand to every module.

Options:
  -t, --terminal SERVICE   Open an interactive bash shell in SERVICE container.
  -v, --verbose            Print env-setup output.
  -h, --help               Show this help.

Commands:
  install                  Symlink watod into /usr/local/bin.
  build                    Pull base images + docker compose build active modules.
  build-base [cpu|cuda]    First-time setup: build base images locally when ghcr
                           hasn't published them yet (CI normally does this).
  fetch-models             Download pretrained model checkpoints into
                           \${WATO_WORLD_DIR}/data/models (the host side of
                           the /data/models bind mount).  Run once after
                           first clone; idempotent thereafter.
  up                       docker compose up -d for active modules.
  down [SERVICE|all]       Stop containers.
  run MODULE BAG [CHUNK]   One-shot module run.
  test [MODULE] [ARGS...]  Run pytest inside the module's dev container.
  <docker-compose-cmd>     Passthrough (ps, logs, pull, exec, ...).

Configuration: edit ACTIVE_MODULES in watod-config.sh (or watod-config.local.sh).

Examples:
  # In watod-config.sh:    export ACTIVE_MODULES="ingest:dev"
  watod build-base cpu     # one-time, only if ghcr lacks the base image
  watod build              # pulls base + builds ingest dev image
  watod up                 # brings up ingest_dev
  watod -t ingest_dev      # shell into the ingest dev container
  watod run ingest /data/bags/scene-0001.mcap
EOF
}

# ---------------------------------------------------------------------------
# Argument parsing.
# ---------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        -t|--terminal)  TERMINAL="$2"; shift 2 ;;
        -v|--verbose)   VERBOSE=1; shift ;;
        -h|--help)      usage; exit 0 ;;
        --)             shift; break ;;
        *)              break ;;
    esac
done

# ---------------------------------------------------------------------------
# Expand ACTIVE_MODULES into a normalized array.  Handles "all" and "all:dev".
# ---------------------------------------------------------------------------
declare -a MODULES_EXPANDED=()
for m in ${ACTIVE_MODULES:-}; do
    if [[ "${m}" == "all" || "${m}" == "all:dev" ]]; then
        local_suffix=""
        [[ "${m}" == "all:dev" ]] && local_suffix=":dev"
        for a in "${ALL_MODULES[@]}"; do
            MODULES_EXPANDED+=("${a}${local_suffix}")
        done
    else
        MODULES_EXPANDED+=("${m}")
    fi
done

# ---------------------------------------------------------------------------
# Generate modules/.env.
# ---------------------------------------------------------------------------
if [[ ${VERBOSE} -eq 1 ]]; then
    bash "${SCRIPTS_DIR}/watod-setup-env.sh"
else
    bash "${SCRIPTS_DIR}/watod-setup-env.sh" >/dev/null
fi

# ---------------------------------------------------------------------------
# Decide which compose files to stack and which base flavors are needed.
# ---------------------------------------------------------------------------
declare -a COMPOSE_FILES=(
    "-f" "${MODULES_DIR}/docker-compose.yaml"
)

needs_gpu=0
needs_dev=0
declare -A NEEDED_BASE_FLAVORS=()
for s in "${MODULES_EXPANDED[@]}"; do
    base="${s%%:*}"
    [[ "${s}" == *":dev" ]] && needs_dev=1
    flavor="$(base_flavor_for "${base}")"
    if [[ -n "${flavor}" ]]; then
        NEEDED_BASE_FLAVORS["${flavor}"]=1
        [[ "${flavor}" == "cuda" ]] && needs_gpu=1
    fi
done

# Force dev compose for `test` (tests run in dev containers).
COMMAND_PRE="${1:-}"
[[ "${COMMAND_PRE}" == "test" ]] && needs_dev=1

if [[ "${GPU_AVAILABLE:-false}" == "true" && ${needs_gpu} -eq 1 ]]; then
    COMPOSE_FILES+=("-f" "${MODULES_DIR}/docker-compose.gpu.yaml")
fi
if [[ ${needs_dev} -eq 1 ]]; then
    COMPOSE_FILES+=("-f" "${MODULES_DIR}/docker-compose.dev.yaml")
fi

# ---------------------------------------------------------------------------
# Profile lists (plain names, no --profile prefix).
#   PRE_PROFILES — <comp>_pre  (source + dependencies stages)
#   ALL_PROFILES — <comp> and <comp>_dev (runtime + dev variants)
# watod-compose.sh receives these via --pre-profiles / --all-profiles flags
# and runs the two-phase build. Mirrors wato_monorepo's calling convention.
# ---------------------------------------------------------------------------
declare -a PRE_PROFILES=()
declare -a ALL_PROFILES=()
declare -a SELECTED_SERVICES=()
for s in "${MODULES_EXPANDED[@]}"; do
    base="${s%%:*}"
    PRE_PROFILES+=("${base}_pre")
    ALL_PROFILES+=("${base}")
    if [[ "${s}" == *":dev" ]]; then
        ALL_PROFILES+=("${base}_dev")
        SELECTED_SERVICES+=("${base}_dev")
    else
        SELECTED_SERVICES+=("${base}")
    fi
done

# Build --profile flag arrays for direct docker compose calls in this script.
declare -a ALL_PROFILE_FLAGS=()
for p in "${ALL_PROFILES[@]}"; do
    ALL_PROFILE_FLAGS+=("--profile" "$p")
done

export COMPOSE_FILES_STR="${COMPOSE_FILES[*]}"        # for watod-run.sh
export GPU_AVAILABLE="${GPU_AVAILABLE:-false}"         # for watod-compose.sh
export SELECTED_SERVICES_STR="${SELECTED_SERVICES[*]}" # for watod-test.sh

# ---------------------------------------------------------------------------
# Command dispatch.  `build` and `up` go through watod-compose.sh, which
# mirrors the monorepo: pull base images from the registry on build.  Locals
# never build bases — CI publishes them.  For first-time setup before CI
# has published, run `watod build-base` once to seed the bases locally.
# ---------------------------------------------------------------------------
COMMAND="${1:-}"
shift || true

# -t shortcut: open a shell in a running container.
if [[ -n "${TERMINAL}" ]]; then
    exec docker compose --env-file "${MODULES_DIR}/.env" "${COMPOSE_FILES[@]}" \
        "${ALL_PROFILE_FLAGS[@]}" exec "${TERMINAL}" bash
fi

case "${COMMAND}" in
    ""|help|-h|--help)
        usage
        ;;
    install)
        exec bash "${SCRIPTS_DIR}/watod-install.sh" "$@"
        ;;
    build-base)
        # Local fallback: build the base images that CI would normally publish
        # to ghcr.  Run once on a fresh clone if `watod build` reports the
        # base image is missing.
        exec bash "${SCRIPTS_DIR}/watod-build-base.sh" "$@"
        ;;
    fetch-models)
        # Download pretrained model checkpoints (DA V2, YOLO-World, ...)
        # into ${WATO_WORLD_DIR}/data/models so GPU containers can mount
        # them at /data/models.
        exec bash "${SCRIPTS_DIR}/watod-fetch-models.sh" "$@"
        ;;
    up)
        exec bash "${SCRIPTS_DIR}/watod-compose.sh" up \
            --pre-profiles "${PRE_PROFILES[@]}" \
            --all-profiles "${ALL_PROFILES[@]}" \
            "$@"
        ;;
    run)
        exec bash "${SCRIPTS_DIR}/watod-run.sh" "$@"
        ;;
    test)
        exec bash "${SCRIPTS_DIR}/watod-test.sh" "$@"
        ;;
    *)
        # Passthrough — `build`, `ps`, `logs`, `pull`, `down`, `exec`, ...
        exec bash "${SCRIPTS_DIR}/watod-compose.sh" "${COMMAND}" \
            --pre-profiles "${PRE_PROFILES[@]}" \
            --all-profiles "${ALL_PROFILES[@]}" \
            "$@"
        ;;
esac
